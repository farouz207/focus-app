<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    package="com.focusflow">

    <!-- Permissions pour les Alarmes Exactes (Planification) -->
    <uses-permission android:name="android.permission.SCHEDULE_EXACT_ALARM" />
    <uses-permission android:name="android.permission.USE_EXACT_ALARM" />
    
    <!-- Permission pour survivre au redémarrage -->
    <uses-permission android:name="android.permission.RECEIVE_BOOT_COMPLETED" />

    <!-- Permission pour le Foreground Service (Séance active) -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <!-- Requis pour Android 14+ -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_SPECIAL_USE" />

    <!-- Permission pour analyser les applications installées -->
    <uses-permission android:name="android.permission.QUERY_ALL_PACKAGES" />

    <!-- Permission pour bloquer les applications par-dessus (Écran bloquant) -->
    <uses-permission android:name="android.permission.SYSTEM_ALERT_WINDOW" />

    <application
        android:allowBackup="true"
        android:icon="@mipmap/ic_launcher"
        android:label="FocusFlow"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/Theme.FocusFlow">

        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:theme="@style/Theme.FocusFlow.NoActionBar">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- Service au premier plan -->
        <service
            android:name=".services.FocusForegroundService"
            android:foregroundServiceType="specialUse"
            android:exported="false" />

        <!-- Service d'accessibilité pour intercepter les ouvertures d'applis -->
        <service
            android:name=".services.AppBlockerService"
            android:permission="android.permission.BIND_ACCESSIBILITY_SERVICE"
            android:exported="true">
            <intent-filter>
                <action android:name="android.accessibilityservice.AccessibilityService" />
            </intent-filter>
            <!-- Nécessite un fichier XML res/xml/accessibility_service_config.xml pour configurer les events -->
            <meta-data
                android:name="android.accessibilityservice"
                android:resource="@xml/accessibility_service_config" />
        </service>

        <!-- Receiver pour les alarmes et le redémarrage -->
        <receiver
            android:name=".receivers.FocusAlarmReceiver"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.BOOT_COMPLETED" />
                <action android:name="android.intent.action.QUICKBOOT_POWERON" />
            </intent-filter>
        </receiver>

    </application>
</manifest>
